    },
    "Al-Mahir is your companion for Quran recitation and memorisation, combining digital Mushaf, AI recitation correction, and live interactive learning sessions with certified scholars." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الماهر هو رفيقك لتلاوة القرآن الكريم وحفظه، حيث يجمع بين المصحف الرقمي، والتصحيح الآلي للتلاوة بالذكاء الاصطناعي، والجلسات التفاعلية المباشرة مع معلمين مجازين."
          }
        }
      }
    },
